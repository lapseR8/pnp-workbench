f=phi(E4); if(f!=0){M=coef(f,x0_0*x0_1*x0_2*x0_3*x0_4*x0_5*x0_6); for(i=1;i<=ncols(M);i++){I=I+M[2,i];}}
option(redSB); ideal G=slimgb(I); if(G[1]==1){print("r3c3_7_700_1.sing UNIT");} else {print("r3c3_7_700_1.sing NONUNIT dim "+string(dim(std(G))));}
quit;
