f=phi(E3); if(f!=0){M=coef(f,x0_0*x0_1*x2_0*x3_0*x4_0*x4_1*x4_2); for(i=1;i<=ncols(M);i++){I=I+M[2,i];}}
f=phi(E4); if(f!=0){M=coef(f,x0_0*x0_1*x2_0*x3_0*x4_0*x4_1*x4_2); for(i=1;i<=ncols(M);i++){I=I+M[2,i];}}
option(redSB); ideal G=slimgb(I); if(G[1]==1){print("c5_7_20113_0.sing UNIT");} else {print("c5_7_20113_0.sing NONUNIT dim "+string(dim(std(G))));}
quit;
