f=phi(E4); if(f!=0){M=coef(f,x0_0*x2_0*x3_0*x3_1*x3_2*x4_0); for(i=1;i<=ncols(M);i++){I=I+M[2,i];}}
option(redSB); ideal G=slimgb(I); if(G[1]==1){print("c5_6_10131_0.sing UNIT");} else {print("c5_6_10131_0.sing NONUNIT dim "+string(dim(std(G))));}
quit;
